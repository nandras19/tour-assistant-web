# Copy this file to .env and fill in the values. The .env file is ignored by git.

# Your Claude API key from https://platform.claude.com (Settings > API keys).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: a secret word that lets the owner view logged inquiries at
# http://localhost:5000/api/inquiries?token=THIS_VALUE
OWNER_TOKEN=change-me

# Optional: which Claude model to use. Defaults to claude-opus-5-5.
# MODEL=claude-opus-5-5
